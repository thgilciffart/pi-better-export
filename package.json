{
  "name": "pi-better-export",
  "version": "0.2.0",
  "description": "Pi's native HTML export with live theme colors, offline LaTeX, equation copying, sharing previews, and print/PDF",
  "type": "module",
  "license": "MIT",
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "export",
    "latex"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "check": "tsc --noEmit",
    "prepublishOnly": "npm run check && npm test"
  },
  "dependencies": {
    "katex": "^0.19.0",
    "open": "^10.2.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.3.0 <2",
    "@earendil-works/pi-tui": "^1.3.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "^26.0.0",
    "jsdom": "^27.0.0",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thgilciffart/pi-better-export.git"
  },
  "homepage": "https://github.com/thgilciffart/pi-better-export#readme",
  "bugs": {
    "url": "https://github.com/thgilciffart/pi-better-export/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
